# Server Configuration
PORT=3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here
DB_DATABASE=pharmatrack_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=24h

# Rate Limiting (Brute-force protection: requests per TTL window in ms)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# SMTP Email Configuration (for Forgot Password, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
MAIL_FROM="Pharmatrack <your_email@gmail.com>"
FRONTEND_URL=http://localhost:5173
